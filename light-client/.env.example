# Host interface Vite is exposed on.
LIGHT_CLIENT_BIND_ADDRESS=127.0.0.1

# Browser URL port. Change this when 5173 is already used on your host.
LIGHT_CLIENT_HOST_PORT=5173

# Vite port inside the container. Usually leave this as 5173.
LIGHT_CLIENT_CONTAINER_PORT=5173

# light-server origin seen from inside the Podman container.
LIGHT_SERVER_PROXY=http://host.containers.internal:3000
